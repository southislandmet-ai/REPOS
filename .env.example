# Copy to .env (or export in your shell) before `npm start`
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
PORT=3000
# Model used for the forecaster brain (default: claude-opus-5-5)
# FORECASTER_MODEL=claude-opus-5-5
# Effort level: low | medium | high | xhigh | max  (default: high)
# FORECASTER_EFFORT=high
# Max output tokens for a single forecast response (default 100000)
# FORECASTER_MAX_TOKENS=100000
